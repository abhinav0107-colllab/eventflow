# Copy to .env and replace every value marked CHANGE_ME (or run `make env`,
# which generates random secrets). Never commit .env.

# PostgreSQL bootstrap/owner password (used only by the migration job).
POSTGRES_PASSWORD=CHANGE_ME_postgres_owner_password
# Password for the least-privilege runtime role used by the API and workers.
EVENTFLOW_APP_DB_PASSWORD=CHANGE_ME_app_role_password
REDIS_PASSWORD=CHANGE_ME_redis_password
# Comma-separated API keys accepted by the API (each >= 16 characters).
EVENTFLOW_API_KEYS=CHANGE_ME_generate_a_long_random_api_key
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin_password

# Optional tuning
EVENTFLOW_LOG_LEVEL=info
EVENTFLOW_WORKER_REPLICAS=2
EVENTFLOW_WORKER_CONCURRENCY=16
