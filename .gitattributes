# Files executed or parsed inside Linux containers must keep LF line endings,
# even when cloned on Windows with core.autocrlf=true.
* text=auto
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.go text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jpg binary
*.png binary
